# ==============================================================================
# CampusCare Environment Variables Template (.env.example)
# Copy to .env and adjust variables as needed for your local environment
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campuscare?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Token Configuration (Must be 256+ bit secret for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# File Storage Abstraction
STORAGE_UPLOAD_DIR=./storage/uploads

# Optional Outbound Mail Notification (Spring Mail)
EMAIL_ENABLED=false
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=notifications@campuscare.edu
